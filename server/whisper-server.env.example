# whisper-server configuration (sourced by the systemd --user service)
# Edit values then: systemctl --user restart whisper-server

WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Unload the model after this many idle seconds (0 = keep loaded forever).
WHISPER_IDLE_TIMEOUT=120

# Batched inference; raise for throughput if VRAM allows (RTX 3060 12GB handles 8-16).
WHISPER_BATCH_SIZE=8

# How many transcriptions may run at once.
WHISPER_MAX_PARALLEL=3

# Diarization (pyannote). Requires HF_TOKEN below with the model's terms accepted.
WHISPER_DIARIZE_MODEL=pyannote/speaker-diarization-community-1

WHISPER_HOST=0.0.0.0
WHISPER_PORT=9000

# Hugging Face token for gated diarization models. REQUIRED for --diarize.
# Get one at https://huggingface.co/settings/tokens and accept the model terms.
HF_TOKEN=hf_your_token_here
HF_HUB_DISABLE_XET=1
