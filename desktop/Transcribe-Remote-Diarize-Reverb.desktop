[Desktop Entry]
Version=1.0
Type=Application
Name=Transcribe with Speakers - Reverb (Remote)
Comment=Transcribe audio/video (files or folders, recursive) via the LAN whisper-server, with speaker labels (Reverb v2)
# IMPORTANT: replace /home/USER with the absolute path where you put the script.
# Uses the Revai/reverb-diarization-v2 model (must be downloaded + HF terms accepted).
Exec=python3 /home/USER/whisper-server/transcribe-remote-diarize.py --diarize --diarize-model Revai/reverb-diarization-v2 %F
Icon=audio-input-microphone
Terminal=true
Categories=AudioVideo;Utility;
MimeType=inode/directory;audio/mpeg;audio/mp4;audio/x-m4a;audio/ogg;audio/wav;audio/x-wav;audio/flac;audio/x-flac;audio/webm;audio/aac;audio/opus;video/mp4;video/mpeg;video/quicktime;video/webm;video/x-matroska;
